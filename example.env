# MotherDuck Data Platform Configuration
MOTHERDUCK__DATABASE=vehicle_catalog
MOTHERDUCK__TOKEN=<API_TOKEN>

# Data Generation Configuration Parameters
DATA_GENERATION__RECORD_COUNT=1000
DATA_GENERATION__SEED=42
DATA_GENERATION__REPLACE=false
DATA_GENERATION__MIN_VEHICLE_AGE=1
DATA_GENERATION__MAX_VEHICLE_AGE=12
DATA_GENERATION__MIN_KM_PER_YEAR=8000
DATA_GENERATION__MAX_KM_PER_YEAR=35000
DATA_GENERATION__PAPERS_VERIFIED_PROBABILITY=0.82

# GROQ API Configuration
GROQ__API_KEY=<API_KEY>

# OpenRouter Configuration
OPENROUTER__API_KEY=<API_KEY>
OPENROUTER__BASE_URL=https://openrouter.ai/api/v1

# Integration Tests
RUN_MOTHERDUCK_INTEGRATION_TESTS=0
