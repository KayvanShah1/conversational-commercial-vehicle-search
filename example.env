# MotherDuck Data Platform Configuration
MOTHERDUCK__DATABASE=vehicle_catalog
MOTHERDUCK__TOKEN=<API_TOKEN>

# Data Generation Configuration Parameters
DATA_GENERATION__RECORD_COUNT=1000
DATA_GENERATION__SEED=42
DATA_GENERATION__REPLACE=false
DATA_GENERATION__MIN_VEHICLE_AGE=1
DATA_GENERATION__MAX_VEHICLE_AGE=12
DATA_GENERATION__MIN_KM_PER_YEAR=8000
DATA_GENERATION__MAX_KM_PER_YEAR=35000
DATA_GENERATION__PAPERS_VERIFIED_PROBABILITY=0.82

# GROQ API Configuration
GROQ__API_KEYS=["<API_KEY>","<SECONDARY_API_KEY>"]
GROQ__BASE_URL=https://api.groq.com/openai/v1
GROQ__PRIMARY_MODEL=openai/gpt-oss-120b
GROQ__FALLBACK_MODELS=["openai/gpt-oss-20b","qwen/qwen3.6-27b","qwen/qwen3.8-27b"]
GROQ__STT_MODEL=whisper-large-v3-turbo
GROQ__TTS_MODEL=canopylabs/orpheus-v1-english
GROQ__TTS_VOICE=daniel
GROQ__TTS_FORMAT=wav
GROQ__TTS_MAX_CHARS=200

# OpenRouter Configuration
OPENROUTER__API_KEY=<API_KEY>
OPENROUTER__BASE_URL=https://openrouter.ai/api/v1
OPENROUTER__FALLBACK_MODELS=["google/gemma-4-26b-a4b-it:free","google/gemma-4-31b-it:free"]

# Agent Runtime Configuration
AGENT_RUNTIME__MAX_TURNS=6
AGENT_RUNTIME__MODEL_TIMEOUT_SECONDS=8.0
AGENT_RUNTIME__TOOL_TIMEOUT_SECONDS=15.0
AGENT_RUNTIME__TRACING_ENABLED=false
AGENT_RUNTIME__TRACE_INCLUDE_SENSITIVE_DATA=false

# Agent Storage and Search Configuration
SESSION_DB_PATH=data/sessions/agent_sessions.sqlite

# Integration Tests
RUN_MOTHERDUCK_INTEGRATION_TESTS=0
